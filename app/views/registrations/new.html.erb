<h1>ユーザー登録</h1>

<% if @user.errors.any? %>
  <div class="alert">
    <p>入力内容を確認してください。</p>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: registration_path do |f| %>
  <div class="form-group">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>

  <div class="form-group">
    <%= f.label :email_address, "メールアドレス" %>
    <%= f.email_field :email_address %>
  </div>

  <div class="form-group">
    <%= f.label :password, "パスワード" %>
    <p class="form-help">
      パスワードは8文字以上で入力してください。
    </p>
    <%= f.password_field :password, minlength: 8 %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, "パスワード確認" %>
    <%= f.password_field :password_confirmation, minlength: 8 %>
  </div>

  <div class="form-group">
    <%= f.submit "登録する" %>
  </div>
<% end %>

<div class="link-group">
  <p><%= link_to "ログイン画面へ", new_session_path %></p>
</div>