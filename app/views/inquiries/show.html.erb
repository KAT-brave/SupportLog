<h1>問い合わせ詳細</h1>

<p><strong>問い合わせNo:</strong> <%= @inquiry.inquiry_no %></p>
<p><strong>タイトル:</strong> <%= @inquiry.title %></p>
<p><strong>本文:</strong> <%= @inquiry.body %></p>
<p><strong>事業者:</strong> <%= @inquiry.customer_name %></p>
<p><strong>電話番号:</strong> <%= @inquiry.phone_number %></p>
<p><strong>機能:</strong> <%= @inquiry.features.map(&:name).join(" / ") %></p>
<p><strong>ステータス:</strong> <%= inquiry_status_label(@inquiry.status) %></p>
<p><strong>優先度:</strong> <%= inquiry_priority_label(@inquiry.priority) %></p>
<p><strong>期日:</strong> <%= @inquiry.due_date %></p>
<p><strong>担当者:</strong> <%= @inquiry.assignee&.name %></p>

<h2>ステータス変更履歴</h2>
<table class="simple-table">
  <thead>
    <tr>
      <th>変更前</th>
      <th>変更後</th>
      <th>理由</th>
      <th>変更者</th>
      <th>変更日時</th>
    </tr>
  </thead>
  <tbody>
    <% @inquiry.inquiry_status_histories.order(created_at: :desc).each do |history| %>
      <tr>
        <td><%= inquiry_status_label(history.from_status) %></td>
        <td><%= inquiry_status_label(history.to_status) %></td>
        <td><%= history.reason %></td>
        <td><%= history.changed_by&.name %></td>
        <td><%= history.created_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "一覧へ戻る", inquiries_path %></p>